# HTCondor submit file for right-boundary finite-time test

universe              = vanilla
executable            = run_right_boundary_tmax.sh
arguments             = $(L) $(lambda_x) $(lambda_zz) $(P_x) $(P_zz) $(T_max_factor) $(ntrials) $(seed) $(sample) $(out_prefix)

transfer_input_files  = ../Project.toml, ../Manifest.toml, ../renyi2_right_boundary_core.jl, ../run_right_boundary_tmax_scan.jl

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = output

output                = logs/right_boundary_tmax_L$(L)_Tf$(T_max_factor)_Px$(P_x)_s$(sample).out
error                 = logs/right_boundary_tmax_L$(L)_Tf$(T_max_factor)_Px$(P_x)_s$(sample).err
log                   = logs/right_boundary_tmax_condor.log

+JobDurationCategory = "Long"

request_cpus          = 4
request_memory        = 8GB
request_disk          = 8 GB

container_image = /ospool/ap40/data/qia.wang/container.sif

# queue format:
# L lambda_x lambda_zz P_x P_zz T_max_factor ntrials seed sample out_prefix
queue L lambda_x lambda_zz P_x P_zz T_max_factor ntrials seed sample out_prefix from params_right_boundary_tmax.txt
