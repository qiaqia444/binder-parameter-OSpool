# HTCondor submit file for Right Boundary Scan: L=48,56 near-critical zoom
# Same physics as jobs_right_boundary.submit (standard initial state, NOT GHZ),
# reuses the existing run_right_boundary.sh / run_right_boundary_scan.jl /
# renyi2_right_boundary_core.jl - only the params file differs
# (L=48,56 only, q=0.38:0.01:0.45 only).

universe              = vanilla
executable            = run_right_boundary.sh
arguments             = $(L) $(lambda_x) $(lambda_zz) $(P_x) $(P_zz) $(ntrials) $(seed) $(sample) $(out_prefix)

# Send only what the job needs
transfer_input_files  = ../Project.toml, ../Manifest.toml, ../renyi2_right_boundary_core.jl, ../run_right_boundary_scan.jl

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = output

# Logs (on submit node)
output                = logs/right_boundary_L$(L)_Px$(P_x)_s$(sample).out
error                 = logs/right_boundary_L$(L)_Px$(P_x)_s$(sample).err
log                   = logs/right_boundary_L48_L56_condor.log

+JobDurationCategory = "Long"

# Resources (same as base/L40 - maxdim is fixed regardless of L, so memory/disk stay the same)
request_cpus          = 4
request_memory        = 8GB
request_disk          = 8 GB

# Use your working container
container_image = /ospool/ap40/data/qia.wang/container.sif

# One job per line in params_right_boundary_L48_L56.txt
queue L lambda_x lambda_zz P_x P_zz ntrials seed sample out_prefix from params_right_boundary_L48_L56.txt
