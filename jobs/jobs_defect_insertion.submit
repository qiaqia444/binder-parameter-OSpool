# HTCondor submit file for the right-boundary defect-insertion diagnostic.
universe              = vanilla
executable            = run_defect_insertion.sh
arguments             = $(L) $(lambda_x) $(lambda_zz) $(P_x) $(P_zz) $(ntrials) $(seed) $(sample) $(out_prefix)

transfer_input_files  = ../Project.toml, ../Manifest.toml, ../renyi2_right_boundary_susceptibility_core.jl, ../defect_insertion_core.jl, ../defect_insertion_run.jl
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = output

output                = logs/defect_insertion_L$(L)_Px$(P_x)_s$(sample).out
error                 = logs/defect_insertion_L$(L)_Px$(P_x)_s$(sample).err
log                   = logs/defect_insertion_condor.log

+JobDurationCategory = "Long"
request_cpus          = 4
request_memory        = 8GB
request_disk          = 8 GB
container_image       = /ospool/ap40/data/qia.wang/container.sif

queue L lambda_x lambda_zz P_x P_zz ntrials seed sample out_prefix from params_defect_insertion.txt
