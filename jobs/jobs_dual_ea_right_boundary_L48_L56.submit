# HTCondor submit file for Right Boundary dual EA Binder Scan: L=48,56 near-critical zoom
# Same physics as jobs_dual_ea_right_boundary.submit; dedicated
# run_dual_ea_right_boundary_L48_L56.sh sets maxdim=512 / cutoff=1e-13 (matching the
# Renyi-2 L48/L56 family) and JULIA_NUM_THREADS=2 to match request_cpus=2 below
# (more, smaller jobs instead of fewer, wider ones).

universe              = vanilla
executable            = run_dual_ea_right_boundary_L48_L56.sh
arguments             = $(L) $(lambda_x) $(lambda_zz) $(P_x) $(P_zz) $(ntrials) $(seed) $(sample) $(out_prefix)

# Send only what the job needs (the dual-EA core includes renyi2_right_boundary_core.jl)
transfer_input_files  = ../Project.toml, ../Manifest.toml, ../renyi2_right_boundary_core.jl, ../dual_ea_right_boundary_core.jl, ../run_dual_ea_right_boundary_scan.jl

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = output

# Logs (on submit node)
output                = logs/dual_ea_right_boundary_L$(L)_Px$(P_x)_s$(sample).out
error                 = logs/dual_ea_right_boundary_L$(L)_Px$(P_x)_s$(sample).err
log                   = logs/dual_ea_right_boundary_L48_L56_condor.log

+JobDurationCategory = "Long"

# Resources (same as the Renyi-2 L48/L56 family: 2 cpus, 8GB)
request_cpus          = 2
request_memory        = 8GB
request_disk          = 8 GB

# Use your working container
container_image = /ospool/ap40/data/qia.wang/container.sif

# One job per line in params_dual_ea_right_boundary_L48_L56.txt
queue L lambda_x lambda_zz P_x P_zz ntrials seed sample out_prefix from params_dual_ea_right_boundary_L48_L56.txt
