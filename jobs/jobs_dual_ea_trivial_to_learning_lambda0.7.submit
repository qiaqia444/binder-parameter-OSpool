# HTCondor submit file for Trivial-to-Learning dual EA Binder Scan (lambda = 0.7: lambda_x = 0.49, lambda_zz = 0.21)
# Dynamics: learning-to-trivial doubled-MPS Born sampling (renyi2_learning_to_trivial_lambda0.7_core.jl),
# observable = dual Edwards-Anderson Binder (dual_ea_right_boundary_core.jl)

universe              = vanilla
executable            = run_dual_ea_trivial_to_learning_lambda0.7.sh
arguments             = $(L) $(lambda_x) $(lambda_zz) $(P_x) $(P_zz) $(ntrials) $(seed) $(sample) $(out_prefix)

# Send only what the job needs (the dual-EA cores include the right-boundary Renyi-2 core
# and the learning-to-trivial core)
transfer_input_files  = ../Project.toml, ../Manifest.toml, ../renyi2_right_boundary_core.jl, ../renyi2_learning_to_trivial_lambda0.7_core.jl, ../dual_ea_right_boundary_core.jl, ../dual_ea_trivial_to_learning_lambda0.7_core.jl, ../run_dual_ea_trivial_to_learning_lambda0.7_scan.jl

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = output

# Logs (on submit node)
output                = logs/dual_ea_trivial_to_learning_lambda0.7_L$(L)_Px$(P_x)_s$(sample).out
error                 = logs/dual_ea_trivial_to_learning_lambda0.7_L$(L)_Px$(P_x)_s$(sample).err
log                   = logs/dual_ea_trivial_to_learning_lambda0.7_condor.log

+JobDurationCategory = "Long"

# Resources (same as the learning-to-trivial family: both weak layers active)
request_cpus          = 4
request_memory        = 8GB
request_disk          = 8 GB

# Use your working container
container_image = /ospool/ap40/data/qia.wang/container.sif

# One job per line in params_dual_ea_trivial_to_learning_lambda0.7.txt
queue L lambda_x lambda_zz P_x P_zz ntrials seed sample out_prefix from params_dual_ea_trivial_to_learning_lambda0.7.txt
