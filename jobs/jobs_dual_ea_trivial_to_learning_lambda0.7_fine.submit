# HTCondor submit file for Trivial-to-Learning (lambda = 0.7) dual EA Binder Scan:
# FINE q grid 0.05:0.005:0.10 (lambda_x = 0.49, lambda_zz = 0.21)
# Same physics, driver and params layout as jobs_dual_ea_trivial_to_learning_lambda0.7.submit,
# but with its own run script (run_dual_ea_trivial_to_learning_lambda0.7_fine.sh, 2 threads to
# match request_cpus = 2). Only the params file and the CPU count differ
# (L = 16, 24, 32, 40 at q = 0.05:0.005:0.10). Output files are named
# dual_ea_trivial_to_learning_lambda0.7_fine_*.

universe              = vanilla
executable            = run_dual_ea_trivial_to_learning_lambda0.7_fine.sh
arguments             = $(L) $(lambda_x) $(lambda_zz) $(P_x) $(P_zz) $(ntrials) $(seed) $(sample) $(out_prefix)

# Send only what the job needs (the dual-EA cores include the right-boundary Renyi-2 core
# and the learning-to-trivial core)
transfer_input_files  = ../Project.toml, ../Manifest.toml, ../renyi2_right_boundary_core.jl, ../renyi2_learning_to_trivial_lambda0.7_core.jl, ../dual_ea_right_boundary_core.jl, ../dual_ea_trivial_to_learning_lambda0.7_core.jl, ../run_dual_ea_trivial_to_learning_lambda0.7_scan.jl

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = output

# Logs (on submit node)
output                = logs/dual_ea_trivial_to_learning_lambda0.7_fine_L$(L)_Px$(P_x)_s$(sample).out
error                 = logs/dual_ea_trivial_to_learning_lambda0.7_fine_L$(L)_Px$(P_x)_s$(sample).err
log                   = logs/dual_ea_trivial_to_learning_lambda0.7_fine_condor.log

+JobDurationCategory = "Long"

# Resources: 2 CPUs (the coarse trivial-to-learning family uses 4); the dedicated
# run_dual_ea_trivial_to_learning_lambda0.7_fine.sh sets the thread counts to 2 to match.
# Both weak layers are active, so keep 8GB.
request_cpus          = 2
request_memory        = 8GB
request_disk          = 8 GB

# Use your working container
container_image = /ospool/ap40/data/qia.wang/container.sif

# One job per line in params_dual_ea_trivial_to_learning_lambda0.7_fine.txt
queue L lambda_x lambda_zz P_x P_zz ntrials seed sample out_prefix from params_dual_ea_trivial_to_learning_lambda0.7_fine.txt
