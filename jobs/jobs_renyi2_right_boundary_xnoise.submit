# HTCondor submit file for Right Boundary Renyi-2 Binder Scan measured AFTER THE LAST X DEPHASING
# Same dynamics and seeds as jobs_right_boundary.submit; observable taken before the last ZZ-dephasing layer
# (renyi2_right_boundary_xnoise_core.jl includes the unchanged production core).

universe              = vanilla
executable            = run_renyi2_right_boundary_xnoise.sh
arguments             = $(L) $(lambda_x) $(lambda_zz) $(P_x) $(P_zz) $(ntrials) $(seed) $(sample) $(out_prefix)

# Send only what the job needs
transfer_input_files  = ../Project.toml, ../Manifest.toml, ../renyi2_right_boundary_core.jl, ../renyi2_right_boundary_xnoise_core.jl, ../run_renyi2_right_boundary_xnoise_scan.jl

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = output

# Logs (on submit node)
output                = logs/renyi2_xnoise_right_boundary_L$(L)_Px$(P_x)_s$(sample).out
error                 = logs/renyi2_xnoise_right_boundary_L$(L)_Px$(P_x)_s$(sample).err
log                   = logs/renyi2_xnoise_right_boundary_condor.log

+JobDurationCategory = "Long"

# Resources (same as jobs_right_boundary.submit)
request_cpus          = 4
request_memory        = 8GB
request_disk          = 8 GB

# Use your working container
container_image = /ospool/ap40/data/qia.wang/container.sif

# One job per line in params_renyi2_right_boundary_xnoise.txt
queue L lambda_x lambda_zz P_x P_zz ntrials seed sample out_prefix from params_renyi2_right_boundary_xnoise.txt
